# ============================================================
# MEMEBOARD CONFIGURATION ENVIRONMENT VARIABLES
# ============================================================

# ── Supabase Credentials ──
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Telegram Bot Integration ──
# Obtained from @BotFather
telegram_bot_key=your_telegram_bot_token
# Optional: Webhook secret token for validating incoming updates
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret

# ── Administration & Security ──
# Secret required to configure webhooks via /api/telegram/setup
ADMIN_SECRET=your_strong_admin_secret

# ── Distributed Rate Limiting (Optional, Upstash Redis) ──
# If omitted, Memeboard uses an internal in-memory sliding window limiter
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── WhatsApp Cloud API Integration (Optional / Post-v2.0) ──
# From Meta for Developers -> WhatsApp -> Configuration
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_token
